rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core identity helper
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // All private user data is strictly scoped under /users/{userId}
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // Sub-collections inherit strict user ownership validation
      match /goals/{goalId} {
        allow read, write: if isOwner(userId) && isValidId(goalId);
      }

      match /tasks/{taskId} {
        allow read, write: if isOwner(userId) && isValidId(taskId);
      }

      match /xp_ledger/{entryId} {
        allow read, write: if isOwner(userId) && isValidId(entryId);
      }

      match /stats/{docId} {
        allow read, write: if isOwner(userId) && isValidId(docId);
      }

      match /chats/{chatId} {
        allow read, write: if isOwner(userId) && isValidId(chatId);
      }

      // Any additional user-scoped nested collections
      match /{allChildren=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
